jQuery(document).ready(function($) {
  $('.tour-slider').owlCarousel({
	loop: false,
	margin: 10,
	nav: true,
	autoplay:true, 
	autoplayTimeout:3000,
	autoplayHoverPause:true,
	responsiveClass: true,
	responsive: {
	  0: {
		items: 2,
		loop: true
	  },
	  600: {
		items: 4,
		loop: true
	  },
	  1000: {
		items: 5
	  }
	}
  })
});

